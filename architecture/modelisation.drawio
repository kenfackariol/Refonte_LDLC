        </mxCell>
        <mxCell id="arch-23" value="logs, compteurs&lt;br&gt;(pré-agrégés)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="arch-6" target="arch-11">
