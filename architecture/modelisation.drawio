        <mxCell id="mongo-34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e6f4ea;strokeColor=#2e7d32;fontSize=11;arcSize=6;" value="&lt;b&gt;Embedded vs References&lt;/b&gt;&lt;br&gt;On &lt;b&gt;imbrique&lt;/b&gt; ce qui est lu avec la fiche et reste borné (specs, prix, stock, attributes).&lt;br&gt;On &lt;b&gt;référence&lt;/b&gt; ce qui grossit sans limite ou vit seul (tous les avis → reviews).&lt;br&gt;Limite d&#39;un document : 16 Mo. Une fiche = 1 lecture, sans jointure." vertex="1">
          <mxGeometry height="90" width="520" x="40" y="450" as="geometry" />
        </mxCell>
        <mxCell id="mongo-35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#b59b00;fontSize=11;arcSize=6;" value="&lt;b&gt;Index&lt;/b&gt;&lt;br&gt;sku (unique) · slug (unique)&lt;br&gt;{ category.path, price.amount } : listes par catégorie triées par prix&lt;br&gt;brand._id · { attributes.k, attributes.v } : tous les filtres&lt;br&gt;texte (name, description, français)&lt;br&gt;reviews : { productId, createdAt: -1 }" vertex="1">
          <mxGeometry height="120" width="520" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="mongo-36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e6f4ea;strokeColor=#2e7d32;fontSize=11;arcSize=6;" value="&lt;b&gt;CAP : CP&lt;/b&gt; (replica set, primaire unique)&lt;br&gt;• fiches : readPreference secondaryPreferred&lt;br&gt;• prix au paiement : primaire + readConcern majority&lt;br&gt;• écritures : w: majority" vertex="1">
          <mxGeometry height="90" width="340" x="720" y="520" as="geometry" />
        </mxCell>
        <mxCell id="mongo-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#b59b00;fontSize=11;arcSize=6;" value="&lt;b&gt;Réservation du stock (Q9)&lt;/b&gt;&lt;br&gt;updateOne({ sku, &quot;stock.quantity&quot;: { $gte: qté } },&lt;br&gt;&amp;nbsp;&amp;nbsp;{ $inc: { &quot;stock.quantity&quot;: -qté } })&lt;br&gt;modifiedCount = 0 → rupture.&lt;br&gt;Plusieurs produits : session.withTransaction()" vertex="1">
          <mxGeometry height="110" width="340" x="720" y="630" as="geometry" />
        </mxCell>
        <mxCell id="mongo-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#b59b00;fontSize=11;arcSize=6;" value="&lt;b&gt;Exemple polymorphe&lt;/b&gt;&lt;br&gt;CPU → specs { socket: &#39;AM5&#39;, cores: 8, tdpW: 120 }&lt;br&gt;Souris → specs { dpi: 32000, buttons: 5, wireless: true }&lt;br&gt;Les deux dans la même collection." vertex="1">
          <mxGeometry height="80" width="520" x="40" y="700" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
