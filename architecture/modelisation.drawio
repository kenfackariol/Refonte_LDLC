          <mxGeometry height="100" width="560" x="640" y="620" as="geometry" />
        </mxCell>
        <mxCell id="redis-30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#b59b00;fontSize=11;arcSize=6;" value="&lt;b&gt;Commandes types&lt;/b&gt;&lt;br&gt;HSET session:s-7f3a9c userId &quot;&quot; createdAt … ; EXPIRE session:s-7f3a9c 1800&lt;br&gt;HINCRBY cart:anon:s-7f3a9c AMD-R7-7800X3D 1 ; EXPIRE cart:anon:s-7f3a9c 604800&lt;br&gt;redis-cli --eval fusion_panier.lua cart:anon:s-7f3a9c cart:user:42 , 2592000" vertex="1">
          <mxGeometry height="80" width="1160" x="40" y="740" as="geometry" />
        </mxCell>
