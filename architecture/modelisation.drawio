        <mxCell id="arch-1" value="Refonte LDLC : Architecture NoSQL polyglotte" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
