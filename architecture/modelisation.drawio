        <mxCell id="arch-7" value="⏱️ &lt;b&gt;Jobs batch&lt;/b&gt;&lt;br&gt;top produits et recherches (horaire)&lt;br&gt;réconciliation BOUGHT_WITH (hebdo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f6f6;strokeColor=#777777;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="380" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="arch-8" value="&lt;b&gt;Lot 1 : MongoDB&lt;/b&gt;&lt;br&gt;Catalogue · stock&lt;br&gt;Replica set ×3 · &lt;b&gt;CP&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e6f4ea;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="560" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="arch-9" value="&lt;b&gt;Lot 2 : Redis&lt;/b&gt;&lt;br&gt;Sessions &amp;amp; paniers (noeviction)&lt;br&gt;Cache produit (allkeys-lru)&lt;br&gt;Sentinel 1P + 2R · &lt;b&gt;AP&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fde8e8;strokeColor=#c0392b;fontSize=11;" vertex="1" parent="1">
