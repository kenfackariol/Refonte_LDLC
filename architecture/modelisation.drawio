        </mxCell>
        <mxCell id="arch-3" value="⚖️ &lt;b&gt;Load balancer&lt;/b&gt;&lt;br&gt;sans sticky session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f6f6;strokeColor=#777777;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="140" width="220" height="46" as="geometry" />
        </mxCell>
        <mxCell id="arch-4" value="&lt;b&gt;Serveurs API / Web sans état (×N)&lt;/b&gt;&lt;br&gt;la session est dans Redis : n&#39;importe quel serveur traite n&#39;importe quelle requête" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f6f6;strokeColor=#777777;fontSize=11;" vertex="1" parent="1">
