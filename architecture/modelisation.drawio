        <mxCell id="arch-11" value="&lt;b&gt;Lot 3 : Cassandra&lt;/b&gt;&lt;br&gt;Logs · compteurs · commandes&lt;br&gt;RF = 3 · &lt;b&gt;AP&lt;/b&gt; (quorum pour les commandes)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e3f3f8;strokeColor=#1b6f8c;fontSize=11;" vertex="1" parent="1">
