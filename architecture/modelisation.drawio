        <mxCell id="neo-23" edge="1" parent="1" source="neo-18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="neo-19" value="USES">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="neo-24" edge="1" parent="1" source="neo-20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="neo-19" value="USES">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="neo-25" edge="1" parent="1" source="neo-20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="neo-21" value="USES">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="neo-26" edge="1" parent="1" source="neo-22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="neo-21" value="ACCEPTS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="neo-27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e8eefc;strokeColor=#1a56db;fontSize=11;arcSize=6;" value="&lt;b&gt;Pourquoi des nœuds Standard ?&lt;/b&gt;&lt;br&gt;Liens directs : 50 CPU AM5 × 150 cartes mères = &lt;b&gt;7 500&lt;/b&gt; relations.&lt;br&gt;Via le nœud AM5 : 50 + 150 = &lt;b&gt;200&lt;/b&gt; relations, et une nouvelle carte AM5 est compatible d&#39;office.&lt;br&gt;USES ≠ ACCEPTS : un boîtier ATX accueille aussi l&#39;ITX (compatibilité non symétrique)." vertex="1">
          <mxGeometry height="120" width="420" x="1150" y="80" as="geometry" />
        </mxCell>
        <mxCell id="neo-28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#b59b00;fontSize=11;arcSize=6;" value="&lt;b&gt;Supernœud et BOUGHT_WITH&lt;/b&gt;&lt;br&gt;Un produit vedette dans 50 000 commandes rendrait « achetés ensemble » trop coûteux.&lt;br&gt;→ relation matérialisée : 1 saut à la lecture.&lt;br&gt;→ mise à jour &lt;b&gt;incrémentale&lt;/b&gt; à l&#39;ingestion d&#39;une commande (quelques paires, idempotente) + réconciliation hebdomadaire." vertex="1">
          <mxGeometry height="130" width="420" x="1150" y="220" as="geometry" />
        </mxCell>
        <mxCell id="neo-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#b59b00;fontSize=11;arcSize=6;" value="&lt;b&gt;Requêtes types&lt;/b&gt;&lt;br&gt;Q1 : (p)&amp;lt;-[:CONTAINS]-(o)-[:CONTAINS]-&amp;gt;(autre) : achetés ensemble&lt;br&gt;Q2 : (boîtier)-[:ACCEPTS]-&amp;gt;(:Standard)&amp;lt;-[:USES]-(cm) + longueur GPU&lt;br&gt;Q3 : configurateur CPU → carte mère → RAM → boîtier (6 sauts)&lt;br&gt;Q4 : similaires (gamme +3, marque +2, socket/mémoire +1)&lt;br&gt;Q5 : filtrage collaboratif (clients aux achats communs)&lt;br&gt;Q7 : ingestion d&#39;une commande + BOUGHT_WITH" vertex="1">
          <mxGeometry height="150" width="420" x="1150" y="370" as="geometry" />
        </mxCell>
        <mxCell id="neo-30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e8eefc;strokeColor=#1a56db;fontSize=11;arcSize=6;" value="&lt;b&gt;CAP : CP&lt;/b&gt; pour les écritures (consensus Raft)&lt;br&gt;Recommandations lues sur les read replicas (cohérence éventuelle, quelques secondes de retard acceptables).&lt;br&gt;Graphe minimal : identifiants seulement (RGPD)." vertex="1">
          <mxGeometry height="100" width="420" x="1150" y="540" as="geometry" />
        </mxCell>
      </root>
