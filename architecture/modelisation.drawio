        <mxCell id="arch-24" value="top_products_by_period" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="arch-7" target="arch-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arch-25" value="réconciliation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="arch-7" target="arch-10">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="800" />
              <mxPoint x="740" y="800" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="arch-26" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;━━ flèche pleine : appel synchrone (pendant la requête)&lt;br&gt;┅┅ flèche pointillée : flux asynchrone (événements, jobs)&lt;br&gt;&lt;br&gt;&lt;b&gt;Règle CAP&lt;/b&gt; : CP là où une erreur coûte de l&#39;argent (prix, stock),&lt;br&gt;AP là où l&#39;indisponibilité coûte plus cher qu&#39;un léger retard (panier, clics)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#b59b00;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="arch-27" value="&lt;b&gt;Parcours d&#39;un paiement&lt;/b&gt;&lt;br&gt;1. Redis : lecture du panier&lt;br&gt;2. MongoDB : prix relu + &lt;b&gt;stock réservé&lt;/b&gt; (updateOne si stock ≥ qté, $inc négatif)&lt;br&gt;3. Cassandra : commande écrite &lt;b&gt;de façon synchrone&lt;/b&gt; (LOCAL_QUORUM), puis confirmée&lt;br&gt;4. Kafka : « commande validée » ; Redis : suppression du panier&lt;br&gt;5. Neo4j : Order + CONTAINS, BOUGHT_WITH + 1 par paire&lt;br&gt;Échec du paiement → stock remis (compensation). Écritures idempotentes." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#b59b00;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="600" y="830" width="560" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
