        <mxCell id="neo-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a56db;fontSize=11;" value="NZXT H5 Flow (boîtier)" vertex="1">
          <mxGeometry height="40" width="170" x="600" y="790" as="geometry" />
