        <mxCell id="cass-56" edge="1" parent="1" source="cass-26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;" target="cass-49" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cass-57" edge="1" parent="1" source="cass-49" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;" target="cass-31" value="écrit le classement">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cass-58" edge="1" parent="1" source="cass-41" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="cass-43" value="items">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cass-59" edge="1" parent="1" source="cass-48" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" target="cass-36" value="INSERT idempotent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cass-60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e3f3f8;strokeColor=#1b6f8c;fontSize=11;arcSize=6;" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#fbe3e3&quot;&gt;&lt;b&gt;[K]&lt;/b&gt; Partition Key&lt;/span&gt; : quelle machine stocke la donnée ; une requête doit la fournir en entier.&lt;br&gt;&lt;span style=&quot;background:#dcecf7&quot;&gt;&lt;b&gt;[C↓]/[C↑]&lt;/b&gt; Clustering Column&lt;/span&gt; : ordre de tri dans la partition (tranches et tri gratuits)." vertex="1">
          <mxGeometry height="110" width="420" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="cass-61" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffbe6;strokeColor=#b59b00;fontSize=11;arcSize=6;" value="&lt;b&gt;Pourquoi (day, hour, bucket) ?&lt;/b&gt;&lt;br&gt;day seul : 20 M × 250 o = &lt;b&gt;5 Go&lt;/b&gt; et toutes les écritures sur 3 nœuds (hot spot).&lt;br&gt;+ hour : &lt;b&gt;500 Mo&lt;/b&gt; à l&#39;heure de pointe, encore trop.&lt;br&gt;+ bucket (÷ 8) : &lt;b&gt;≈ 62 Mo&lt;/b&gt;, réparti sur le cluster.&lt;br&gt;Même raisonnement pour T4 et T6 (bucket dans la clé)." vertex="1">
          <mxGeometry height="120" width="420" x="40" y="690" as="geometry" />
        </mxCell>
        <mxCell id="cass-62" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e3f3f8;strokeColor=#1b6f8c;fontSize=11;arcSize=6;" value="&lt;b&gt;CAP : AP&lt;/b&gt;, cohérence réglable (RF = 3)&lt;br&gt;Logs : LOCAL_ONE (débit).&lt;br&gt;Commandes : LOCAL_QUORUM en écriture et lecture → 2 + 2 &amp;gt; 3.&lt;br&gt;Cassandra ne trie pas sur un compteur → top pré-calculé (T5)." vertex="1">
          <mxGeometry height="100" width="360" x="540" y="620" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
