ECHO "Lot 2 : Panier et sessions (Redis)"
ECHO "Exécution : redis-cli < commandes.redis   (Redis 4 ou plus)"
ECHO "(la fusion de paniers se lance à part : voir fusion_panier.lua)"
ECHO "ATTENTION : FLUSHDB vide la base courante, à lancer sur une base de test"

FLUSHDB

ECHO "1. SESSION : création à la première visite (TTL 30 min glissant)"
HSET session:s-7f3a9c userId "" createdAt 1794945600 lastSeen 1794945600 ip 82.64.12.34 ua "Mozilla/5.0" csrf "tk_91ab"
EXPIRE session:s-7f3a9c 1800

ECHO "A chaque requête HTTP : lecture + rafraîchissement du TTL (inactivité)"
HGETALL session:s-7f3a9c
HSET session:s-7f3a9c lastSeen 1794945720
EXPIRE session:s-7f3a9c 1800
TTL session:s-7f3a9c

ECHO "2. PANIER ANONYME : Hash sku -> quantité (TTL 7 jours)"
ECHO "Ajout au panier : HINCRBY est atomique (deux clics simultanés = +2, pas de perte)"
HINCRBY cart:anon:s-7f3a9c AMD-R7-7800X3D 1
HINCRBY cart:anon:s-7f3a9c ASUS-B650-PLUS 1
HINCRBY cart:anon:s-7f3a9c AMD-R7-7800X3D 1
EXPIRE cart:anon:s-7f3a9c 604800

ECHO "Affichage du panier"
HGETALL cart:anon:s-7f3a9c
ECHO "Nombre de lignes (badge du panier dans l'en-tête)"
HLEN cart:anon:s-7f3a9c

ECHO "Modifier une quantité / retirer un produit"
HSET cart:anon:s-7f3a9c AMD-R7-7800X3D 1
HINCRBY cart:anon:s-7f3a9c ASUS-B650-PLUS -1
HDEL cart:anon:s-7f3a9c ASUS-B650-PLUS
HINCRBY cart:anon:s-7f3a9c ASUS-B650-PLUS 1

ECHO "3. PRODUITS CONSULTÉS RÉCEMMENT : List bornée à 10"
LPUSH recent:s-7f3a9c AMD-R7-7800X3D
LPUSH recent:s-7f3a9c LOGI-GPRO-X2
LPUSH recent:s-7f3a9c ASUS-B650-PLUS
LTRIM recent:s-7f3a9c 0 9
EXPIRE recent:s-7f3a9c 604800
LRANGE recent:s-7f3a9c 0 -1

ECHO "4. CONNEXION du client 42"
ECHO "Panier déjà existant du client (rempli depuis un autre appareil)"
HINCRBY cart:user:42 AMD-R7-7800X3D 1
HINCRBY cart:user:42 LOGI-GPRO-X2 1
EXPIRE cart:user:42 2592000

ECHO "Rattacher la session au client + index des sessions du client"
HSET session:s-7f3a9c userId 42
SADD user:42:sessions s-7f3a9c
EXPIRE user:42:sessions 2592000
SMEMBERS user:42:sessions

ECHO "Sessions actives du client : une session expirée est retirée du Set à la lecture"
SADD user:42:sessions s-expiree
EXISTS session:s-expiree
SREM user:42:sessions s-expiree
SMEMBERS user:42:sessions

ECHO "5. CACHE PRODUIT (cache-aside devant MongoDB, TTL 5 min)"
ECHO "(en production : instance redis-cache séparée, maxmemory-policy allkeys-lru)"
HSET product:AMD-R7-7800X3D name "AMD Ryzen 7 7800X3D" price 389.95 stock 142
EXPIRE product:AMD-R7-7800X3D 300
HMGET product:AMD-R7-7800X3D name price

ECHO "6. Vérification des TTL posés"
TTL session:s-7f3a9c
TTL cart:anon:s-7f3a9c
TTL cart:user:42
TTL product:AMD-R7-7800X3D
